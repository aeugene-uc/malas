# Copy to backend/.env and fill in. Never commit .env.

# Dev database on the VPS MariaDB. Pilot data lives in its own database
# with its own user (S16), so `prisma migrate reset` can never reach it.
DATABASE_URL="mysql://malas:PASSWORD@HOST:3306/malas_dev"

# Pre-made empty database for `prisma migrate dev`, because the malas user
# cannot create databases.
SHADOW_DATABASE_URL="mysql://malas:PASSWORD@HOST:3306/malas_shadow"

PORT=3000
NODE_ENV=development

# Signs the auth token. Any long random string.
JWT_SECRET=""

# Gemma 4 on NVIDIA, with DeepSeek as the fallback (S14).
NVIDIA_API_KEY=""
